{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(shutdown:*)",
      "Bash(format:*)",
      "Bash(reg:*)",
      "Bash(diskpart:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(Format-Volume:*)",
      "PowerShell(Stop-Computer:*)",
      "PowerShell(Restart-Computer:*)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Read(//c/Users/semin/byesu-claude/config/**)",
      "Read(//c/Users/semin/byesu-claude/byesu-claude.cmd)",
      "Edit(//c/Users/semin/byesu-claude/guard.py)",
      "Edit(//c/Users/semin/byesu-claude/config/**)",
      "Edit(//c/Windows/**)",
      "Edit(//c/Program Files/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/semin/AppData/Local/Programs/Python/Python311/python.exe\" \"C:/Users/semin/byesu-claude/guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
